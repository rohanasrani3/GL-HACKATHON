# Which model backend to use: openrouter (default, hosted) | ollama (local) | claude | mock (canned answers, no model needed)
MODEL_PROVIDER=openrouter

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# Any vision model with structured-output support. ~$0.0003 per screenshot for the default.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# Tried in order if the primary is down (comma-separated)
OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash-lite

# --- Local model via Ollama (only if MODEL_PROVIDER=ollama) ---
OLLAMA_URL=http://localhost:11434
# Must be a VISION model - later.exe sends an image. A text-only model (qwen2.5, llama3.1, ...)
# will answer confidently about a screenshot it cannot see.
OLLAMA_MODEL=gemma4:12b

# --- Claude direct (only if MODEL_PROVIDER=claude) ---
CLAUDE_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...

# Optional shared secret the phone must send as X-Api-Token (set this if the server is reachable publicly)
API_TOKEN=
DEFAULT_TIMEZONE=Asia/Hong_Kong

# --- Policy gate (CLAUDE.md §2.5). Defaults shown; raise AUTO_ADD_THRESHOLD to be asked more often ---
#   confidence >= AUTO_ADD_THRESHOLD   -> "auto_add": the app adds it, then notifies with Undo
#   ASK_THRESHOLD <= confidence < AUTO -> "ask": the app confirms with you first
#   confidence < ASK_THRESHOLD         -> dropped, never sent to the phone
AUTO_ADD_THRESHOLD=0.6
ASK_THRESHOLD=0.5

# Longest image side sent to the model, in pixels. Lower = cheaper and faster, worse on dense posters.
MAX_IMAGE_SIDE=1280
