# Which model backend to use: ollama | claude | mock (canned answers, no model needed)
MODEL_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
# Hosted fallback (only used when MODEL_PROVIDER=claude)
CLAUDE_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
# Optional shared secret the phone must send as X-Api-Token
API_TOKEN=
DEFAULT_TIMEZONE=Asia/Hong_Kong
