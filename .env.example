# Copy to .env and edit. Env vars override config.yaml.

# --- Model ---------------------------------------------------------------
OSAGENT_PROVIDER=ollama
OSAGENT_MODEL=gemma4
OSAGENT_BASE_URL=http://localhost:11434
# Only used when OSAGENT_PROVIDER=openai_compat
OSAGENT_API_KEY=
# e.g. OSAGENT_PROVIDER=openai_compat
#      OSAGENT_BASE_URL=https://api.openai.com/v1
#      OSAGENT_MODEL=gpt-4o-mini

# --- Behaviour -----------------------------------------------------------
OSAGENT_CONFIG=config.yaml
OSAGENT_LOG_LEVEL=INFO
